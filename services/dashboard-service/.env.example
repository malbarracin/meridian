# Claves opcionales: sin Finnhub se usan fixtures; sin NewsAPI se usa HN Algolia.
FINNHUB_API_KEY=
NEWS_API_KEY=
# TTL en segundos; CoinGecko aplica al menos 60 segundos.
DASHBOARD_CACHE_TTL_SECONDS=60
# true permite la demo sin llamadas externas.
DASHBOARD_USE_MOCK=false
# Puerto publicado en el host; Compose mantiene 8081 dentro del contenedor.
PORT=8081
