{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Dashboard Service API",
    "description" : "Datos públicos agregados de dólar, FX, criptomonedas, bolsa y noticias de IA/tecnología. Los fallos de un proveedor se informan en la lista degraded sin cambiar el status HTTP. Con DASHBOARD_USE_MOCK=true las respuestas usan fixtures estáticas y el ejemplo de este contrato.",
    "version" : "1.0"
  },
  "servers" : [ {
    "url" : "http://localhost:8081",
    "description" : "Entorno local"
  } ],
  "tags" : [ {
    "name" : "Dashboard",
    "description" : "Datos públicos agregados de mercado y noticias"
  } ],
  "paths" : {
    "/api/v1/dashboard/summary" : {
      "get" : {
        "tags" : [ "Dashboard" ],
        "summary" : "Obtener el dashboard agregado",
        "description" : "Resumen de dólar ARS, criptomonedas y bolsa. Los fallos se informan en degraded.",
        "operationId" : "getSummary",
        "responses" : {
          "401" : {
            "description" : "JWT ausente, inválido o expirado",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "200" : {
            "description" : "Datos agregados del dashboard",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SummaryResponse"
                },
                "examples" : {
                  "modoMock" : {
                    "$ref" : "#/components/examples/SummaryMock"
                  }
                }
              }
            }
          },
          "500" : {
            "description" : "Error interno inesperado durante la orquestación",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                },
                "examples" : {
                  "errorInterno" : {
                    "$ref" : "#/components/examples/InternalError"
                  }
                }
              }
            }
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ]
      }
    },
    "/api/v1/dashboard/charts" : {
      "get" : {
        "tags" : [ "Dashboard" ],
        "summary" : "Obtener la serie histórica de un activo",
        "description" : "Últimos siete días; si falla el proveedor devuelve datos stale o puntos vacíos.",
        "operationId" : "getCharts",
        "parameters" : [ {
          "name" : "asset",
          "in" : "query",
          "description" : "Activo soportado",
          "required" : true,
          "schema" : {
            "type" : "string",
            "enum" : [ "BTC", "ETH", "AAPL", "MSFT", "SPY" ]
          }
        }, {
          "name" : "range",
          "in" : "query",
          "description" : "Ventana histórica",
          "required" : false,
          "schema" : {
            "type" : "string",
            "enum" : [ "7d" ]
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Serie histórica disponible",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ChartsResponse"
                },
                "examples" : {
                  "modoMock" : {
                    "$ref" : "#/components/examples/ChartsMock"
                  }
                }
              }
            }
          },
          "400" : {
            "description" : "Activo o rango no soportado",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "JWT ausente, inválido o expirado",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "ErrorResponse" : {
        "type" : "object",
        "properties" : {
          "code" : {
            "type" : "string",
            "enum" : [ "VALIDATION_ERROR", "BAD_REQUEST", "NOT_FOUND", "CONFLICT", "INTERNAL_ERROR", "UNAUTHORIZED" ]
          },
          "message" : {
            "type" : "string"
          },
          "details" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/FieldError"
            }
          },
          "timestamp" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "FieldError" : {
        "type" : "object",
        "properties" : {
          "field" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          }
        }
      },
      "CryptoQuote" : {
        "type" : "object",
        "properties" : {
          "priceUsd" : {
            "type" : "number"
          },
          "change24hPct" : {
            "type" : "number"
          }
        }
      },
      "EquityQuote" : {
        "type" : "object",
        "properties" : {
          "price" : {
            "type" : "number"
          },
          "currency" : {
            "type" : "string"
          }
        }
      },
      "FxSection" : {
        "type" : "object",
        "properties" : {
          "quotes" : {
            "type" : "object",
            "additionalProperties" : {
              "$ref" : "#/components/schemas/RateQuote"
            }
          }
        }
      },
      "RateQuote" : {
        "type" : "object",
        "properties" : {
          "compra" : {
            "type" : "number"
          },
          "venta" : {
            "type" : "number"
          }
        }
      },
      "SummaryResponse" : {
        "type" : "object",
        "properties" : {
          "brand" : {
            "type" : "string"
          },
          "generatedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "fx" : {
            "$ref" : "#/components/schemas/FxSection"
          },
          "crypto" : {
            "type" : "object",
            "additionalProperties" : {
              "$ref" : "#/components/schemas/CryptoQuote"
            }
          },
          "equities" : {
            "type" : "object",
            "additionalProperties" : {
              "$ref" : "#/components/schemas/EquityQuote"
            }
          },
          "degraded" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          }
        }
      },
      "ChartPoint" : {
        "type" : "object",
        "properties" : {
          "t" : {
            "type" : "string",
            "format" : "date-time",
            "description" : "Fecha UTC",
            "example" : "2026-10-22T00:00:00Z"
          },
          "v" : {
            "type" : "number",
            "description" : "Precio en USD",
            "example" : 67000
          }
        }
      },
      "ChartsResponse" : {
        "type" : "object",
        "properties" : {
          "asset" : {
            "type" : "string",
            "description" : "Activo normalizado",
            "example" : "BTC"
          },
          "range" : {
            "type" : "string",
            "description" : "Ventana histórica",
            "example" : "7d"
          },
          "points" : {
            "type" : "array",
            "description" : "Puntos ordenados por fecha",
            "items" : {
              "$ref" : "#/components/schemas/ChartPoint"
            }
          },
          "degraded" : {
            "type" : "boolean",
            "description" : "Fallo del proveedor sin caché fresca",
            "example" : false
          }
        }
      }
    },
    "examples" : {
      "ChartsMock" : {
        "summary" : "Serie BTC en modo mock",
        "value" : {
          "asset" : "BTC",
          "range" : "7d",
          "points" : [ {
            "t" : "2026-10-15T00:00:00Z",
            "v" : 67000.0
          }, {
            "t" : "2026-10-16T00:00:00Z",
            "v" : 67000.0
          }, {
            "t" : "2026-10-17T00:00:00Z",
            "v" : 67000.0
          }, {
            "t" : "2026-10-18T00:00:00Z",
            "v" : 67000.0
          }, {
            "t" : "2026-10-19T00:00:00Z",
            "v" : 67000.0
          }, {
            "t" : "2026-10-20T00:00:00Z",
            "v" : 67000.0
          }, {
            "t" : "2026-10-21T00:00:00Z",
            "v" : 67000.0
          }, {
            "t" : "2026-10-22T00:00:00Z",
            "v" : 67000.0
          } ],
          "degraded" : false
        }
      },
      "SummaryMock" : {
        "summary" : "Dashboard en modo mock",
        "description" : "Respuesta completa con DASHBOARD_USE_MOCK=true; los valores son fixtures estáticas y no cotizaciones reales.",
        "value" : {
          "brand" : "Meridian",
          "generatedAt" : "2026-10-22T10:05:00Z",
          "fx" : {
            "quotes" : {
              "usd_oficial" : {
                "compra" : 1000.0,
                "venta" : 1040.0
              },
              "usd_blue" : {
                "compra" : 1200.0,
                "venta" : 1220.0
              }
            }
          },
          "crypto" : {
            "bitcoin" : {
              "priceUsd" : 67000.0,
              "change24hPct" : 2.5
            },
            "ethereum" : {
              "priceUsd" : 3500.0,
              "change24hPct" : -1.2
            }
          },
          "equities" : {
            "MSFT" : {
              "price" : 415,
              "currency" : "USD"
            },
            "SPY" : {
              "price" : 450.0,
              "currency" : "USD"
            },
            "AAPL" : {
              "price" : 175,
              "currency" : "USD"
            }
          },
          "degraded" : [ ]
        }
      },
      "InternalError" : {
        "summary" : "Error interno",
        "description" : "Error inesperado durante la orquestación; no expone detalles internos.",
        "value" : {
          "code" : "INTERNAL_ERROR",
          "message" : "Error interno",
          "details" : [ ],
          "timestamp" : "2026-10-22T10:05:00Z"
        }
      }
    },
    "securitySchemes" : {
      "bearerAuth" : {
        "type" : "http",
        "scheme" : "bearer",
        "bearerFormat" : "JWT"
      }
    }
  }
}