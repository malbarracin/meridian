{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Dashboard Service API",
    "description" : "Datos públicos agregados de dólar, FX, criptomonedas, bolsa y noticias de IA/tecnología. Los fallos de un proveedor se informan en la lista degraded sin cambiar el status HTTP. Con DASHBOARD_USE_MOCK=true las respuestas usan fixtures estáticas y el ejemplo de este contrato.",
    "version" : "1.0"
  },
  "servers" : [ {
    "url" : "http://localhost:8081",
    "description" : "Entorno local"
  } ],
  "tags" : [ {
    "name" : "Dashboard",
    "description" : "Datos públicos agregados de mercado y noticias"
  } ],
  "paths" : {
    "/api/v1/dashboard" : {
      "get" : {
        "tags" : [ "Dashboard" ],
        "summary" : "Obtener el dashboard agregado",
        "description" : "Agrega cotizaciones de dólar y FX, precios e histórico de cripto, quotes y velas de bolsa y noticias de IA/tecnología. Con DASHBOARD_USE_MOCK=true devuelve fixtures estáticas sin llamadas externas. Los fallos de un proveedor no generan error HTTP: la sección se informa en degraded y se sirve cache o una lista vacía.",
        "operationId" : "getDashboard",
        "responses" : {
          "200" : {
            "description" : "Datos agregados del dashboard",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/DashboardResponse"
                },
                "examples" : {
                  "modoMock" : {
                    "$ref" : "#/components/examples/DashboardMock"
                  }
                }
              }
            }
          },
          "500" : {
            "description" : "Error interno inesperado durante la orquestación",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                },
                "examples" : {
                  "errorInterno" : {
                    "$ref" : "#/components/examples/InternalError"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "DolarResponse" : {
        "type" : "object",
        "description" : "Cotización de compra y venta de un tipo de dólar en ARS",
        "properties" : {
          "tipo" : {
            "type" : "string",
            "description" : "Tipo de dólar",
            "example" : "oficial"
          },
          "compra" : {
            "type" : "number",
            "description" : "Precio de compra en ARS",
            "example" : 1000.0
          },
          "venta" : {
            "type" : "number",
            "description" : "Precio de venta en ARS",
            "example" : 1040.0
          }
        }
      },
      "FxRateResponse" : {
        "type" : "object",
        "description" : "Tipo de cambio entre dos divisas",
        "properties" : {
          "from" : {
            "type" : "string",
            "description" : "Moneda origen (ISO 4217)",
            "example" : "USD"
          },
          "to" : {
            "type" : "string",
            "description" : "Moneda destino (ISO 4217)",
            "example" : "EUR"
          },
          "rate" : {
            "type" : "number",
            "description" : "Unidades de la moneda destino por una unidad de la origen",
            "example" : 0.92
          }
        }
      },
      "CryptoResponse" : {
        "type" : "object",
        "description" : "Precio actual y variación de las últimas 24 horas de una criptomoneda",
        "properties" : {
          "id" : {
            "type" : "string",
            "description" : "Identificador de la moneda en CoinGecko",
            "example" : "bitcoin"
          },
          "symbol" : {
            "type" : "string",
            "description" : "Símbolo de la moneda",
            "example" : "BTC"
          },
          "priceUsd" : {
            "type" : "number",
            "description" : "Precio actual en USD",
            "example" : 67000
          },
          "change24h" : {
            "type" : "number",
            "description" : "Variación porcentual de las últimas 24 horas",
            "example" : 2.5
          }
        }
      },
      "CryptoPricePoint" : {
        "type" : "object",
        "description" : "Punto de la serie histórica de una criptomoneda",
        "properties" : {
          "timestamp" : {
            "type" : "string",
            "format" : "date-time",
            "description" : "Fecha y hora UTC del punto",
            "example" : "2026-10-15T00:00:00Z"
          },
          "priceUsd" : {
            "type" : "number",
            "description" : "Precio en USD en ese momento",
            "example" : 67000
          }
        }
      },
      "EquityQuoteResponse" : {
        "type" : "object",
        "description" : "Último precio de una acción o ETF",
        "properties" : {
          "ticker" : {
            "type" : "string",
            "description" : "Ticker del instrumento",
            "example" : "AAPL"
          },
          "price" : {
            "type" : "number",
            "description" : "Último precio",
            "example" : 175.0
          },
          "currency" : {
            "type" : "string",
            "description" : "Moneda del precio (ISO 4217)",
            "example" : "USD"
          }
        }
      },
      "OhlcPoint" : {
        "type" : "object",
        "description" : "Vela OHLC diaria expresada con timestamp Unix en segundos",
        "properties" : {
          "t" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Timestamp Unix en segundos",
            "example" : 1792627200
          },
          "o" : {
            "type" : "number",
            "description" : "Precio de apertura",
            "example" : 175.0
          },
          "h" : {
            "type" : "number",
            "description" : "Precio máximo",
            "example" : 175.0
          },
          "l" : {
            "type" : "number",
            "description" : "Precio mínimo",
            "example" : 175.0
          },
          "c" : {
            "type" : "number",
            "description" : "Precio de cierre",
            "example" : 175.0
          },
          "v" : {
            "type" : "number",
            "description" : "Volumen negociado",
            "example" : 0
          }
        }
      },
      "CandleResponse" : {
        "type" : "object",
        "description" : "Serie OHLC diaria de un instrumento",
        "properties" : {
          "ticker" : {
            "type" : "string",
            "description" : "Ticker del instrumento",
            "example" : "AAPL"
          },
          "ohlcPoints" : {
            "type" : "array",
            "description" : "Velas diarias del rango consultado",
            "items" : {
              "$ref" : "#/components/schemas/OhlcPoint"
            }
          }
        }
      },
      "NewsArticleResponse" : {
        "type" : "object",
        "description" : "Noticia de IA y tecnología normalizada",
        "properties" : {
          "id" : {
            "type" : "string",
            "description" : "Identificador de la noticia (URL en NewsAPI u objectID en HN)",
            "example" : "demo-ai"
          },
          "title" : {
            "type" : "string",
            "description" : "Título",
            "example" : "AI research demo"
          },
          "summary" : {
            "type" : "string",
            "description" : "Resumen o descripción",
            "example" : "Static AI news fixture"
          },
          "source" : {
            "type" : "string",
            "description" : "Fuente de la noticia",
            "example" : "Meridian Demo"
          },
          "publishedAt" : {
            "type" : "string",
            "format" : "date-time",
            "description" : "Fecha de publicación en UTC",
            "example" : "2026-01-01T12:00:00Z"
          },
          "url" : {
            "type" : "string",
            "description" : "URL del artículo",
            "example" : "https://example.com/demo-ai"
          },
          "topic" : {
            "type" : "string",
            "description" : "Tema de la noticia; siempre ai-tech",
            "example" : "ai-tech"
          }
        }
      },
      "DashboardResponse" : {
        "type" : "object",
        "description" : "Datos agregados de mercado y noticias para el dashboard",
        "properties" : {
          "dolar" : {
            "type" : "array",
            "description" : "Cotizaciones de dólar oficial y blue en ARS",
            "items" : {
              "$ref" : "#/components/schemas/DolarResponse"
            }
          },
          "fx" : {
            "type" : "array",
            "description" : "Tipos de cambio internacionales USD→EUR y USD→BRL",
            "items" : {
              "$ref" : "#/components/schemas/FxRateResponse"
            }
          },
          "crypto" : {
            "type" : "array",
            "description" : "Precio actual y variación 24h de BTC y ETH en USD",
            "items" : {
              "$ref" : "#/components/schemas/CryptoResponse"
            }
          },
          "cryptoHistory" : {
            "type" : "array",
            "description" : "Serie de precios de los últimos 7 días de BTC y ETH",
            "items" : {
              "$ref" : "#/components/schemas/CryptoPricePoint"
            }
          },
          "equities" : {
            "type" : "array",
            "description" : "Últimos precios de AAPL, MSFT y SPY",
            "items" : {
              "$ref" : "#/components/schemas/EquityQuoteResponse"
            }
          },
          "equityCandles" : {
            "type" : "array",
            "description" : "Velas OHLC diarias por ticker",
            "items" : {
              "$ref" : "#/components/schemas/CandleResponse"
            }
          },
          "news" : {
            "type" : "array",
            "description" : "Noticias de IA y tecnología normalizadas",
            "items" : {
              "$ref" : "#/components/schemas/NewsArticleResponse"
            }
          },
          "degraded" : {
            "type" : "array",
            "description" : "Secciones sin datos frescos",
            "items" : {
              "type" : "string",
              "example" : "dolar"
            }
          }
        }
      },
      "ErrorResponse" : {
        "type" : "object",
        "properties" : {
          "code" : {
            "type" : "string",
            "enum" : [ "VALIDATION_ERROR", "BAD_REQUEST", "NOT_FOUND", "CONFLICT", "INTERNAL_ERROR" ]
          },
          "message" : {
            "type" : "string"
          },
          "details" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/FieldError"
            }
          },
          "timestamp" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "FieldError" : {
        "type" : "object",
        "properties" : {
          "field" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          }
        }
      }
    },
