                  "value": "application/json"
                }
              ],
              "_postman_previewlanguage": "json",
              "body": "{\n  \"code\": \"NOT_FOUND\",\n  \"message\": \"Usuario no encontrado por id: 6710f3a2c9e77c00ffffffff\",\n  \"details\": [],\n  \"timestamp\": \"2026-10-22T10:05:00Z\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "3. Salud",
      "description": "Verificación de disponibilidad del servicio.",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            },
            "description": "Endpoint de Actuator. Responde 200 con status UP cuando el servicio y MongoDB están disponibles."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('servicio UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "200 - servicio disponible",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/actuator/health",
