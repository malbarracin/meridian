                  "raw": "{{baseUrl}}/api/v1/users/6710f3a2c9e77c00ffffffff",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "users",
                    "6710f3a2c9e77c00ffffffff"
                  ]
