                    "{{baseUrl}}"
                  ],
                  "path": [
                    "actuator",
                    "health"
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "_postman_previewlanguage": "json",
              "body": "{\n  \"status\": \"UP\"\n}"
            }
          ]
        }
      ]
    }
  ]
}
