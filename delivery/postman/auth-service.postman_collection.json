                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "me"
              ]
            },
            "description": "Devuelve el perfil persistido del usuario identificado por el subject del JWT enviado en Authorization: Bearer. No expone la contraseña ni su hash. Respuestas: 200 perfil, 401 JWT ausente, inválido o vencido, 404 usuario eliminado, 500 error interno. Requiere haber ejecutado el alta o el login para tener {{authToken}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('devuelve el perfil del token', () => pm.expect(body.id).to.eql(pm.collectionVariables.get('userId')));",
                  "pm.test('incluye name, email y createdAt', () => { pm.expect(body.name).to.be.a('string'); pm.expect(body.email).to.be.a('string'); pm.expect(body.createdAt).to.be.a('string'); });",
                  "pm.test('no expone la contraseña ni su hash', () => { pm.expect(body.password).to.be.undefined; pm.expect(body.passwordHash).to.be.undefined; });"
                ]
              }
            }
