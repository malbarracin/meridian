              "body": "{\n  \"asset\": \"BTC\",\n  \"range\": \"7d\",\n  \"points\": [\n    {\n      \"t\": \"2026-10-16T00:00:00Z\",\n      \"v\": 66000\n    },\n    {\n      \"t\": \"2026-10-22T00:00:00Z\",\n      \"v\": 67000\n    }\n  ],\n  \"degraded\": false\n}"
