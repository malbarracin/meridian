          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('tiene asset', () => pm.expect(body).to.have.property('asset'));",
                  "pm.test('tiene range', () => pm.expect(body).to.have.property('range'));",
                  "pm.test('tiene points', () => pm.expect(body.points).to.be.an('array'));",
                  "pm.test('tiene degraded', () => pm.expect(body).to.have.property('degraded'));"
                ]
              }
            }
          ],
