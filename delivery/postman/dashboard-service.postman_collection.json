{
  "info": {
    "name": "dashboard-service",
    "description": "Endpoints protegidos por JWT del dashboard-service: summary, charts, news. Requiere Authorization: Bearer {{accessToken}} obtenido desde auth-service. BASE_URL apunta al puerto 8081. DASHBOARD_USE_MOCK indica el modo con el que se arrancó el servicio. JWT_SECRET obligatorio en el backend; FINNHUB_API_KEY/NEWS_API_KEY opcionales (modo mock/fallback).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://localhost:8081"
    },
    {
      "key": "accessToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Salud",
      "description": "Verifica que el servicio esté arriba antes de consultar el dashboard.",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/actuator/health",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            },
            "description": "Endpoint de Actuator. Responde 200 con status UP cuando el servicio está disponible."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('status UP', () => pm.expect(body.status).to.eql('UP'));"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "200 - servicio disponible",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{BASE_URL}}/actuator/health",
                  "host": [
                    "{{BASE_URL}}"
                  ],
                  "path": [
                    "actuator",
                    "health"
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/vnd.spring-boot.actuator.v3+json"
                }
              ],
              "_postman_previewlanguage": "json",
              "body": "{\n  \"status\": \"UP\",\n  \"groups\": [\n    \"liveness\",\n    \"readiness\"\n  ]\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "2. Dashboard (JWT)",
      "description": "Endpoints protegidos por JWT. Obtener accessToken desde auth-service (login) y setearlo en variable {{accessToken}}.",
      "item": [
        {
          "name": "Summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/dashboard/summary",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "v1",
                "dashboard",
                "summary"
              ]
            },
            "description": "Resumen agregado: dólar ARS, cripto y bolsa. Protegido por JWT."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('tiene brand', () => pm.expect(body).to.have.property('brand'));",
                  "pm.test('tiene generatedAt', () => pm.expect(body).to.have.property('generatedAt'));",
                  "pm.test('tiene fx', () => pm.expect(body).to.have.property('fx'));",
                  "pm.test('tiene crypto', () => pm.expect(body).to.have.property('crypto'));",
                  "pm.test('tiene equities', () => pm.expect(body).to.have.property('equities'));",
                  "pm.test('tiene degraded', () => pm.expect(body.degraded).to.be.an('array'));"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "200 - summary modo mock",
              "originalRequest": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}",
                    "type": "text"
                  }
                ],
                "url": {
                  "raw": "{{BASE_URL}}/api/v1/dashboard/summary",
                  "host": [
                    "{{BASE_URL}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "dashboard",
                    "summary"
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "_postman_previewlanguage": "json",
              "body": "{\n  \"brand\": \"Meridian\",\n  \"generatedAt\": \"2026-10-22T10:05:00Z\",\n  \"fx\": {\n    \"quotes\": {\n      \"usd_oficial\": {\n        \"compra\": 1000,\n        \"venta\": 1040\n      },\n      \"usd_blue\": {\n        \"compra\": 1200,\n        \"venta\": 1220\n      }\n    }\n  },\n  \"crypto\": {\n    \"bitcoin\": {\n      \"priceUsd\": 67000,\n      \"change24hPct\": 2.5\n    },\n    \"ethereum\": {\n      \"priceUsd\": 3500,\n      \"change24hPct\": -1.2\n    }\n  },\n  \"equities\": {\n    \"AAPL\": {\n      \"price\": 175,\n      \"currency\": \"USD\"\n    },\n    \"MSFT\": {\n      \"price\": 415,\n      \"currency\": \"USD\"\n    },\n    \"SPY\": {\n      \"price\": 450,\n      \"currency\": \"USD\"\n    }\n  },\n  \"degraded\": []\n}"
            }
          ]
        },
        {
          "name": "Charts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/dashboard/charts?asset=BTC&range=7d",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "v1",
                "dashboard",
                "charts"
              ],
              "query": [
