meta {
  name: Login con credenciales inválidas
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{userEmail}}",
    "password": "otraPassword999"
  }
}

assert {
  res.status: eq 401
  res.body.code: eq UNAUTHORIZED
}

docs {
  Envía una contraseña que no coincide con el usuario registrado. Responde 401 UNAUTHORIZED con el mensaje genérico "Credenciales inválidas" y details vacío, sin revelar qué credencial falló.

  Requiere el alta previa para tener userEmail. El mismo error se devuelve si el email no existe.
}
