meta {
  name: Alta con JSON mal formado
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/users
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Ana Pérez",
}

assert {
  res.status: eq 400
  res.body.code: eq BAD_REQUEST
}

docs {
  Cuerpo JSON incompleto. Responde 400 BAD_REQUEST sin exponer detalles internos.
}
