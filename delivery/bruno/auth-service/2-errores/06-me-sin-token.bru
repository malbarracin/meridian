meta {
  name: Perfil sin token
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/v1/users/me
  body: none
  auth: none
}

assert {
  res.status: eq 401
  res.body.code: eq UNAUTHORIZED
}

docs {
  Invoca GET /api/v1/users/me sin la cabecera Authorization. Responde 401 UNAUTHORIZED con el contrato uniforme y details vacío.
}
