meta {
  name: Iniciar sesión
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{userEmail}}",
    "password": "password123"
  }
}

assert {
  res.status: eq 200
  res.body.user.id: isString
  res.body.token: isString
}

script:post-response {
  bru.setVar("authToken", res.body.token);
}

docs {
  Verifica el email normalizado y la contraseña contra el hash BCrypt. Responde 200 con AuthResponse: perfil público en user y JWT HS256 en token.

  Respuestas: 200 sesión iniciada, 400 datos inválidos, 401 credenciales incorrectas, 500 error interno. El 401 usa el mismo mensaje genérico tanto si el email no existe como si la contraseña no coincide.

  Requiere haber ejecutado "Registrar usuario" para tener userEmail; guarda el nuevo JWT en authToken para el pedido GET /me.
}
