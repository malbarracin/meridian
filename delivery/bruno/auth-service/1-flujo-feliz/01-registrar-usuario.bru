meta {
  name: Registrar usuario
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/users
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Ana Pérez",
    "email": "{{userEmail}}",
    "password": "password123"
  }
}

script:pre-request {
  bru.setVar("userEmail", `ana.${Date.now()}@example.com`);
}

assert {
  res.status: eq 201
  res.body.id: isString
  res.body.email: isString
}

script:post-response {
  bru.setVar("userId", res.body.id);
}

docs {
  Registra un usuario con nombre, email y contraseña. El email se normaliza (trim y minúsculas) y debe ser único; la contraseña se guarda solo como hash BCrypt.

  Respuestas: 201 usuario creado, 400 datos inválidos, 409 email ya registrado, 500 error interno.

  Genera un email único por corrida y guarda el id en la variable userId para el siguiente pedido.
}
