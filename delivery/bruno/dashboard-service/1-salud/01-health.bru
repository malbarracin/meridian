meta {
  name: Health check
  type: http
  seq: 1
}

get {
  url: {{BASE_URL}}/actuator/health
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.status: eq UP
}

docs {
  Endpoint de Actuator. Responde 200 con status UP cuando el servicio está disponible.
  No depende de proveedores externos.
}
