meta {
  name: Dashboard con proveedores reales
  type: http
  seq: 3
}

get {
  url: {{BASE_URL}}/api/v1/dashboard
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.dolar: isArray
  res.body.fx: isArray
  res.body.crypto: isArray
  res.body.cryptoHistory: isArray
  res.body.equities: isArray
  res.body.equityCandles: isArray
  res.body.news: isArray
  res.body.degraded: isArray
}

docs {
  Misma ruta con DASHBOARD_USE_MOCK=false. El servicio consulta DolarApi,
  Frankfurter, CoinGecko, Finnhub y NewsAPI (con fallback HN Algolia).

  Requiere salida a internet. Sin FINNHUB_API_KEY se usan fixtures de bolsa y sin
  NEWS_API_KEY el fallback de noticias. Las secciones caídas aparecen en degraded;
  el status sigue siendo 200. Los valores cambian en cada corrida.
}
